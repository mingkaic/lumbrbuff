module(
    name = "lumbrbuff",
    version = "0.1",
)

bazel_dep(name = "abseil-cpp", version = "20240722.0", repo_name = "com_google_absl")
bazel_dep(name = "cpp-httplib", version = "0.22.0")
bazel_dep(name = "gazelle", version = "0.42.0", repo_name = "bazel_gazelle")
bazel_dep(name = "googletest", version = "1.15.2", repo_name = "gtest")
bazel_dep(name = "nlohmann_json", version = "3.11.3")
bazel_dep(name = "rules_go", version = "0.53.0", repo_name = "io_bazel_rules_go")
bazel_dep(name = "rules_python", version = "0.40.0")

# === EXTENSION: rules_go ===
go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.23.4")

go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "go.mod")
use_repo(
    go_deps,
    "com_github_gin_gonic_gin",
    "com_github_lib_pq",
)

# === EXTENSION: python ===

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.11")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pip",
    python_version = "3.11",
    requirements_by_platform = {
        "//:requirements_linux.txt": "linux_*",
        "//:requirements_darwin.txt": "osx_*",
        "//:requirements_windows.txt": "windows_*",
    },
)
use_repo(pip, "pip")
